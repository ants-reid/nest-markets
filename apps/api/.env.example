APP_NAME=Market Hunter API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=market_hunter

LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4.1-mini
OPENAI_TIMEOUT=30.0
OPENAI_TEMPERATURE=0.0
POLYGON_API_KEY=your_polygon_api_key_here

# Security - API Key Authentication
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable authentication in development
API_KEY=

# CORS Allowed Origins (comma-separated)
# Example: http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# IBKR Broker Integration — Paper Trading (Phase 15)
# Paper account: DU prefix (e.g. DUP153837), Live account: U prefix
IBKR_ACCOUNT_ID=your_paper_account_id_here
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_IS_PAPER=true
# Credentials used by the Client Portal Gateway login (never commit real values)
IBKR_USERNAME=
IBKR_PASSWORD=

# Broker mode isolation (MH-24B) — authoritative paper/live guards
# All three must remain at their safe defaults — changing any to a live value
# will raise LiveExecutionBlockedError until a deliberate unlock phase.
BROKER_PROVIDER=ibkr
BROKER_MODE=paper
LIVE_EXECUTION_ENABLED=false
IBKR_ACCOUNT_TYPE=paper
