{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalyst_schema_v1.json",
  "title": "CatalystSchemaV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "affected_assets",
    "catalyst_type",
    "directional_bias",
    "freshness_score",
    "relevance_score",
    "priced_in_risk",
    "time_horizon",
    "summary"
  ],
  "properties": {
    "affected_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalyst_type": {
      "type": "string",
      "enum": ["macro", "earnings", "sector_news", "commodity_move", "central_bank", "geopolitics", "none"]
    },
    "directional_bias": {
      "type": "string",
      "enum": ["bullish", "bearish", "mixed", "neutral"]
    },
    "freshness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "priced_in_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "time_horizon": {
      "type": "string",
      "enum": ["minutes", "hours", "days", "weeks"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
